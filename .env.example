# RieszManager configuration. Copy to .env (or run ./rieszctl init) and edit.
# This single file is read by docker compose, the backend container and the host runner.
# Values containing "$" must be wrapped in single quotes.

# ---- Account ------------------------------------------------------------------
RIESZ_USERNAME=admin
# Either a plain password ...
RIESZ_PASSWORD=change-me-please
# ... or (recommended) a hash produced by `./rieszctl hash-password`; it takes precedence.
# RIESZ_PASSWORD_HASH='pbkdf2_sha256$...'
# Refuse to use the app until TOTP two-factor authentication has been set up.
RIESZ_REQUIRE_TOTP=false
RIESZ_TOTP_ISSUER=RieszManager
# Login sessions last this many days when "stay signed in" is ticked.
RIESZ_SESSION_DAYS=30

# ---- Secrets (generate with ./rieszctl init) ------------------------------------------
RIESZ_SECRET_KEY=
RUNNER_TOKEN=

# ---- Network --------------------------------------------------------------------
# Public URL the app is served at (scheme + host, no trailing slash). Required for
# CSRF/WebSocket origin checks and secure cookies when using https.
RIESZ_PUBLIC_ORIGIN=https://riesz.example.com
# Extra host names allowed to reach the backend (comma separated).
RIESZ_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra trusted origins (comma separated), e.g. http://localhost:18573 for local access.
RIESZ_EXTRA_ORIGINS=
# Host interface and port the gateway listens on. Keep 127.0.0.1 behind a tunnel/reverse proxy.
RIESZ_BIND=127.0.0.1
RIESZ_PORT=18573
# Trust the CF-Connecting-IP header for client IPs (only when behind Cloudflare and bound to localhost).
RIESZ_TRUST_CF_HEADER=false

# ---- Login throttling -------------------------------------------------------------
RIESZ_LOGIN_MAX_FAILURES=5
RIESZ_LOGIN_MAX_FAILURES_GLOBAL=30
RIESZ_LOGIN_LOCKOUT_MINUTES=15

# ---- Host user / runner ---------------------------------------------------------------
# uid/gid of the host user that runs Claude Code and the runner (`id -u`, `id -g`).
RIESZ_UID=1000
RIESZ_GID=1000
# Directory whose sub-folders are the projects (e.g. ~/work). Absolute path.
WORKSPACE_ROOT=/home/you/work
# Absolute path of the directory holding the runner's Unix socket (mounted into the backend).
RUNNER_SOCKET_DIR=/home/you/.local/state/riesz-manager/run
# Runner state (uploads, prompt history). Defaults to ~/.local/state/riesz-manager.
# RUNNER_STATE_DIR=
# Path to the claude binary (auto-detected when empty).
# RUNNER_CLAUDE_BIN=
# Permission mode for new sessions: default | acceptEdits | plan | auto | bypassPermissions
RUNNER_DEFAULT_PERMISSION_MODE=default
# Allow switching sessions to bypassPermissions from the web UI.
RUNNER_ALLOW_BYPASS=false
# Stop idle claude processes after this many seconds (they resume transparently). A process
# with background commands, subagents or monitors still running is not idle.
RUNNER_IDLE_TIMEOUT=1800
# Launch claude through a login shell so it sees the same environment as your terminal.
RUNNER_LOGIN_SHELL=true
# Claude in Chrome for sessions run from the web UI: auto (follow your /chrome default
# in ~/.claude.json), on, or off. Non-interactive claude only connects with --chrome.
RUNNER_CHROME=auto
# How sessions run from the web UI treat messages from other Claude Code sessions
# (Claude Code's crossSessionInbound): accept, hold or refuse; empty uses your own setting.
# Messages between sessions in different permission modes are held for approval by default,
# which a headless session cannot give, so they expire; accept delivers them.
RUNNER_CROSS_SESSION_INBOUND=accept
# Balances of other AI services shown by the doll: a JSON file listing each service and a
# command that prints its API key (format in runner/riesz_runner/balances.py).
# Default <RUNNER_STATE_DIR>/balances.json; without the file no balances are shown.
# RUNNER_BALANCES_FILE=
# Seconds to wait for an answer to a permission request or question before declining it and
# telling Claude the user is away (0 waits forever).
RUNNER_PERMISSION_TIMEOUT=1800
# In bypassPermissions mode Claude Code still stops a Bash command when it cannot rule out a
# dangerous removal. Approve it when every removal is inside a project's tmp folder
# (<workspace>/<project>/.../tmp), or when the command removes nothing at all.
RUNNER_ALLOW_TMP_REMOVAL=false
# Allow browsing files of sessions whose directory is outside WORKSPACE_ROOT.
RUNNER_ALLOW_EXTERNAL_FILES=false
# Largest file shown in the file viewer (bytes).
RUNNER_MAX_FILE_BYTES=2097152

# ---- Voice input (optional) -----------------------------------------------------------
# With an OpenAI-compatible key, recordings are transcribed on the server; otherwise
# the browser's built-in speech recognition is used where available.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
RIESZ_TRANSCRIBE_MODEL=gpt-4o-transcribe
# RIESZ_TRANSCRIBE_LANGUAGE=zh

# ---- Misc ---------------------------------------------------------------------------
RIESZ_MAX_UPLOAD_MB=100
RIESZ_DEBUG=false

# ---- Push notifications (optional) ----------------------------------------------------
# Key that signs Web Push messages (PEM, or the base64url-encoded raw private key).
# Leave empty to have one generated on first use and kept in data/backend/vapid_private.pem.
# Changing it invalidates every device's subscription (they need to switch push on again).
RIESZ_VAPID_PRIVATE_KEY=
