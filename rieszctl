#!/usr/bin/env bash
# RieszManager management helper. Run `./rieszctl help` for usage.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT/.env"
UNIT_NAME="riesz-runner.service"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

compose() { docker compose --project-directory "$ROOT" -f "$ROOT/docker-compose.yml" "$@"; }

env_get() {
  # Print the value of KEY from .env (quotes stripped), or empty.
  local key="$1"
  [[ -f "$ENV_FILE" ]] || return 0
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n1 | sed -e "s/^'\(.*\)'$/\1/" -e 's/^"\(.*\)"$/\1/'
}

env_set() {
  # Set KEY=VALUE in .env, replacing an existing (possibly commented) line.
  local key="$1" value="$2"
  if grep -qE "^#? ?${key}=" "$ENV_FILE"; then
    python3 - "$ENV_FILE" "$key" "$value" <<'PY'
import re, sys
path, key, value = sys.argv[1:4]
text = open(path).read()
text = re.sub(rf"^#? ?{re.escape(key)}=.*$", lambda m: f"{key}={value}", text, count=1, flags=re.M)
open(path, "w").write(text)
PY
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

random_secret() { python3 -c "import secrets; print(secrets.token_urlsafe(${1:-48}))"; }

cmd_init() {
  if [[ -f "$ENV_FILE" ]]; then
    warn ".env already exists; only filling in missing secrets"
  else
    cp "$ROOT/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    env_set RIESZ_UID "$(id -u)"
    env_set RIESZ_GID "$(id -g)"
    env_set RUNNER_SOCKET_DIR "$HOME/.local/state/riesz-manager/run"
    env_set WORKSPACE_ROOT "${WORKSPACE_ROOT:-$HOME}"
    local pw; pw="$(random_secret 12)"
    env_set RIESZ_PASSWORD "$pw"
    say "Generated a temporary password: $pw  (change it with ./rieszctl hash-password)"
  fi
  [[ -n "$(env_get RIESZ_SECRET_KEY)" ]] || env_set RIESZ_SECRET_KEY "$(random_secret 50)"
  [[ -n "$(env_get RUNNER_TOKEN)" ]] || env_set RUNNER_TOKEN "$(random_secret 32)"
  mkdir -p "$ROOT/data/backend"
  say "Edit $ENV_FILE (WORKSPACE_ROOT, RIESZ_PUBLIC_ORIGIN, ...) then run: ./rieszctl runner install && ./rieszctl up"
}

cmd_runner_install() {
  [[ -f "$ENV_FILE" ]] || die "run ./rieszctl init first"
  command -v python3 >/dev/null || die "python3 is required"
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' || die "python >= 3.10 is required"
  say "Creating runner virtualenv"
  python3 -m venv "$ROOT/runner/.venv"
  "$ROOT/runner/.venv/bin/pip" install -q --upgrade pip
  "$ROOT/runner/.venv/bin/pip" install -q -r "$ROOT/runner/requirements.txt"
  mkdir -p "$UNIT_DIR"
  cat > "$UNIT_DIR/$UNIT_NAME" <<UNIT
[Unit]
Description=RieszManager host runner (drives Claude Code sessions)
After=default.target

[Service]
Type=simple
WorkingDirectory=$ROOT/runner
ExecStart=$ROOT/runner/.venv/bin/python -m riesz_runner --env-file $ENV_FILE
# Graceful reload: waits until no hosted Claude session is working, then re-executes.
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=3
# Let the runner close its claude children itself (they finish cleanly on stdin EOF).
KillMode=mixed
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=SHELL=${SHELL:-/bin/bash}

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  if systemctl --user is-active --quiet "$UNIT_NAME"; then
    # Already running (upgrade): pick up the new code without interrupting busy sessions.
    systemctl --user reload "$UNIT_NAME"
    say "Runner will reload as soon as no hosted session is working"
  else
    systemctl --user enable --now "$UNIT_NAME"
  fi
  if ! loginctl show-user "$USER" -p Linger 2>/dev/null | grep -q yes; then
    if loginctl enable-linger "$USER" 2>/dev/null || sudo -n loginctl enable-linger "$USER" 2>/dev/null; then
      say "Enabled lingering so the runner keeps running after logout"
    else
      warn "Run 'sudo loginctl enable-linger $USER' so the runner survives logout and reboots"
    fi
  fi
  sleep 1
  systemctl --user --no-pager status "$UNIT_NAME" | head -n 5 || true
}

cmd_runner() {
  local action="${1:-status}"
  case "$action" in
    install) cmd_runner_install ;;
    start|stop|restart|status) systemctl --user --no-pager "$action" "$UNIT_NAME" ;;
    reload) systemctl --user reload "$UNIT_NAME" && say "Runner will reload as soon as no hosted session is working" ;;
    logs) journalctl --user -u "$UNIT_NAME" -n 200 -f ;;
    uninstall)
      systemctl --user disable --now "$UNIT_NAME" || true
      rm -f "$UNIT_DIR/$UNIT_NAME"
      systemctl --user daemon-reload ;;
    run) exec "$ROOT/runner/.venv/bin/python" -m riesz_runner --env-file "$ENV_FILE" ;;
    *) die "unknown runner action: $action" ;;
  esac
}

cmd_status() {
  local sock_dir; sock_dir="$(env_get RUNNER_SOCKET_DIR)"
  if [[ -S "$sock_dir/runner.sock" ]]; then
    local token; token="$(env_get RUNNER_TOKEN)"
    if curl -fsS --unix-socket "$sock_dir/runner.sock" -H "Authorization: Bearer $token" http://runner/v1/health >/dev/null; then
      say "runner: healthy ($sock_dir/runner.sock)"
    else
      warn "runner: socket exists but health check failed"
    fi
  else
    warn "runner: socket not found at $sock_dir/runner.sock"
  fi
  compose ps
  local port; port="$(env_get RIESZ_PORT)"
  if curl -fsS "http://127.0.0.1:${port:-18573}/api/healthz" >/dev/null; then
    say "gateway: http://127.0.0.1:${port:-18573} is up"
  else
    warn "gateway: not reachable on port ${port:-18573}"
  fi
}

usage() {
  cat <<EOF
Usage: ./rieszctl <command>

  init                 create .env with random secrets and a temporary password
  runner install       install the host runner as a systemd user service
  runner <action>      start | stop | restart | reload | status | logs | uninstall | run (foreground)
                       (reload = apply new code once no hosted session is working; restart interrupts them)
  up                   build and start the containers
  down                 stop the containers
  restart              restart the containers
  logs [service]       follow container logs
  status               check runner, containers and gateway
  session <command>    start and drive hosted sessions, e.g. from another Claude Code session:
                       new [-C DIR] MESSAGE | send ID MESSAGE | wait ID | reply ID | show ID
                       | list [--mine|--all] | keep ID on|off | stop ID   (session --help for more)
  hash-password        generate RIESZ_PASSWORD_HASH for .env
  reset-totp           disable two-factor authentication (lost authenticator)
  revoke-sessions      log out every device
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    init) cmd_init ;;
    runner) cmd_runner "$@" ;;
    up) mkdir -p "$ROOT/data/backend"; compose up -d --build ;;
    down) compose down ;;
    restart) compose restart ;;
    logs) compose logs -f --tail=200 "$@" ;;
    status) cmd_status ;;
    session) PYTHONPATH="$ROOT/runner" exec python3 -m riesz_runner.client --env-file "$ENV_FILE" "$@" ;;
    hash-password) compose run --rm -it backend python manage.py hash_password ;;
    reset-totp) compose exec backend python manage.py reset_totp ;;
    revoke-sessions) compose exec backend python manage.py revoke_sessions ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
